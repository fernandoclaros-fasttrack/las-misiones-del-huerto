# Copia este archivo a .env.local y rellena con la config de tu proyecto Firebase
# (Firebase console > Configuración del proyecto > tus apps > SDK setup and configuration).
# Sin estas variables, la app usa un almacenamiento local de desarrollo (no persiste
# entre dispositivos) — ver src/shared/localStore.ts.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email de la única cuenta de Firebase Authentication que protege ambas pantallas
# (ver MOO-24). Solo hay una cuenta familiar; también recibe el enlace de
# "olvidé mi contraseña".
VITE_AUTH_EMAIL=

# Opcional, solo en local (nunca se incluye en el build de producción — ver
# `import.meta.env.DEV` en src/shared/useAuth.ts). Si se rellena, la app inicia sesión
# automáticamente con VITE_AUTH_EMAIL al arrancar en dev, para poder verificar cambios contra el
# Firestore de producción real sin tener que escribir la contraseña a mano en cada sesión.
VITE_DEV_AUTH_PASSWORD=
